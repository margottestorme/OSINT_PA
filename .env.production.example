# =============================================================
# Configuration PRODUCTION — OSINT Platform
# Copier en .env.production puis remplir les valeurs marquées CHANGE_ME.
# NE JAMAIS committer le fichier .env.production rempli (cf .gitignore).
# =============================================================

# --- Mode application ---
DEBUG=false
SQL_ECHO=false
LOG_LEVEL=INFO
APP_NAME=OSINT-Platform
APP_VERSION=0.1.0
API_PREFIX=/api

# --- Secret JWT ---
# Générer une clé forte (au moins 32 octets aléatoires) avec :
#   openssl rand -hex 32
# ou :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Le garde-fou de démarrage REFUSE de lancer l'app en production (DEBUG=false)
# si cette valeur reste une valeur par défaut connue.
JWT_SECRET_KEY=CHANGE_ME_GENERER_UNE_CLE_FORTE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15

# --- PostgreSQL (service "db" du docker-compose) ---
# Ces 3 variables pilotent le conteneur PostgreSQL ET les URLs ci-dessous :
# le mot de passe doit être identique partout.
POSTGRES_USER=osint_user
POSTGRES_PASSWORD=CHANGE_ME_MOT_DE_PASSE_DB_FORT
POSTGRES_DB=osint_db

# URLs de connexion (host = nom du service Docker "db", pas localhost)
DATABASE_URL=postgresql+asyncpg://osint_user:CHANGE_ME_MOT_DE_PASSE_DB_FORT@db:5432/osint_db
DATABASE_URL_SYNC=postgresql://osint_user:CHANGE_ME_MOT_DE_PASSE_DB_FORT@db:5432/osint_db

# --- Redis (service "redis" du docker-compose) ---
REDIS_URL=redis://redis:6379/0

# --- Sécurité HTTP ---
# Domaine réel servi en HTTPS (plusieurs origines possibles, séparées par des virgules)
ALLOWED_ORIGINS=https://votre-domaine.fr
EXTERNAL_REQUEST_TIMEOUT=10
GLOBAL_RATE_LIMIT=100

# --- Clés API sources OSINT (toutes optionnelles ; vide = source désactivée) ---
# GitHub (Lot Vert)      : https://github.com/settings/tokens
GITHUB_TOKEN=
# VirusTotal (Freemium)  : https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# AlienVault OTX (Freemium) : https://otx.alienvault.com/api
OTX_API_KEY=
# Hunter.io (Freemium)   : https://hunter.io/api-keys
HUNTER_API_KEY=
# Brave Search API (Freemium) — recherche web généraliste : https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# --- Clés API énumération de pseudos (Module 15) — optionnelles, gratuites ---
# YouTube Data API v3 : https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
# Twitch (API Helix)   : https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Reconnaissance faciale : seuil de matching (optionnel, défauts raisonnables) ---
FACE_MATCH_THRESHOLD=0.55
FACE_MATCH_MIN_MARGIN=0.03

# --- Sauvegardes (clé GPG pour le chiffrement des dumps, cf scripts/backup.sh) ---
# Destinataire GPG (email/ID de la clé publique importée) ou passphrase symétrique.
BACKUP_GPG_RECIPIENT=CHANGE_ME_ID_CLE_GPG
