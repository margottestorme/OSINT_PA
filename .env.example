# =============================================================================
#  HÔTES DES SERVICES — localhost (Option B, local) vs noms Docker (Option A)
# -----------------------------------------------------------------------------
#  Ce fichier est pré-réglé pour une installation LOCALE (services sur localhost).
#  Pour une stack 100 % Docker (docker compose up -d), remplacez l'hôte de chaque
#  URL ci-dessous par le NOM DE SERVICE Docker correspondant :
#     localhost:5432  ->  db:5432             (PostgreSQL)
#     localhost:6379  ->  redis:6379          (Redis)
#     localhost:9200  ->  elasticsearch:9200  (Elasticsearch)
#  (dans le réseau Docker, "localhost" désigne le conteneur lui-même, pas ses voisins)
# =============================================================================

# Base de données PostgreSQL
# Option B (local) : @localhost:5432   |   Option A (Docker) : @db:5432
DATABASE_URL=postgresql+asyncpg://osint_user:osint_pass@localhost:5432/osint_db
DATABASE_URL_SYNC=postgresql://osint_user:osint_pass@localhost:5432/osint_db

# Redis
# Option B (local) : @localhost:6379   |   Option A (Docker) : @redis:6379
REDIS_URL=redis://localhost:6379/0

# Elasticsearch (Module 11 — optionnel, dégradation propre si absent)
# Option B (local) : //localhost:9200  |   Option A (Docker) : //elasticsearch:9200
ELASTICSEARCH_URL=http://localhost:9200

# Chiffrement DB (Module 12 — pgcrypto) : clé symétrique des colonnes sensibles.
# Générez une clé forte (ex : openssl rand -hex 32) — JAMAIS versionnée.
DB_ENCRYPTION_KEY=change-me-in-production

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Application
APP_NAME=OSINT-Platform
APP_VERSION=0.1.0
DEBUG=true
SQL_ECHO=false
LOG_LEVEL=DEBUG

# API
API_PREFIX=/api

# Sécurité
ALLOWED_ORIGINS=http://localhost:8000
EXTERNAL_REQUEST_TIMEOUT=10
GLOBAL_RATE_LIMIT=100

# --- Clés API sources OSINT (toutes optionnelles ; vide = source désactivée) ---
# GitHub (Lot Vert) — optionnel, monte le quota 60/h → 5000/h.
#   Créer un Personal Access Token (scope public) : https://github.com/settings/tokens
GITHUB_TOKEN=
# VirusTotal (Freemium) — 4 req/min, 500/jour. Clé gratuite après inscription :
#   https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# AlienVault OTX (Freemium) — clé gratuite dans les paramètres du compte :
#   https://otx.alienvault.com/api
OTX_API_KEY=
# Hunter.io (Freemium) — 25 recherches + 50 vérifs/mois. Clé dans le dashboard :
#   https://hunter.io/api-keys
HUNTER_API_KEY=

# --- Clés API énumération de pseudos (Module 15) — optionnelles, gratuites ---
# YouTube Data API v3 — quota gratuit généreux (10 000 unités/jour, ~1 unité/vérif).
#   Console Google Cloud > APIs & Services > Identifiants > Créer une clé API :
#   https://console.cloud.google.com/apis/credentials (activer "YouTube Data API v3" au préalable)
YOUTUBE_API_KEY=
# Twitch (API Helix) — app gratuite, aucune limite pratique pour ce cas d'usage.
#   Créer une application : https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
