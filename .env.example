# Base de données PostgreSQL
DATABASE_URL=postgresql+asyncpg://osint_user:osint_pass@localhost:5432/osint_db
DATABASE_URL_SYNC=postgresql://osint_user:osint_pass@localhost:5432/osint_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Application
APP_NAME=OSINT-Platform
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=DEBUG

# API
API_PREFIX=/api
