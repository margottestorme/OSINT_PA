# Base de données PostgreSQL
DATABASE_URL=postgresql+asyncpg://osint_user:osint_pass@localhost:5432/osint_db
DATABASE_URL_SYNC=postgresql://osint_user:osint_pass@localhost:5432/osint_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Elasticsearch (Module 11 — optionnel, dégradation propre si absent)
# Dev-hôte : localhost. Dans un conteneur app : http://elasticsearch:9200
ELASTICSEARCH_URL=http://localhost:9200

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Application
APP_NAME=OSINT-Platform
APP_VERSION=0.1.0
DEBUG=true
SQL_ECHO=false
LOG_LEVEL=DEBUG

# API
API_PREFIX=/api

# Sécurité
ALLOWED_ORIGINS=http://localhost:8000
EXTERNAL_REQUEST_TIMEOUT=10
GLOBAL_RATE_LIMIT=100

# --- Clés API sources OSINT (toutes optionnelles ; vide = source désactivée) ---
# GitHub (Lot Vert) — optionnel, monte le quota 60/h → 5000/h.
#   Créer un Personal Access Token (scope public) : https://github.com/settings/tokens
GITHUB_TOKEN=
# VirusTotal (Freemium) — 4 req/min, 500/jour. Clé gratuite après inscription :
#   https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# AlienVault OTX (Freemium) — clé gratuite dans les paramètres du compte :
#   https://otx.alienvault.com/api
OTX_API_KEY=
# Hunter.io (Freemium) — 25 recherches + 50 vérifs/mois. Clé dans le dashboard :
#   https://hunter.io/api-keys
HUNTER_API_KEY=
